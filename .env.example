# ---- LLM -------------------------------------------------------------------
# Preferred: xAI Grok. Get a key at https://console.x.ai (prepaid credits; ~$5 minimum).
XAI_API_KEY=
# Alternative OpenAI-compatible providers (used automatically if XAI_API_KEY is empty):
GROQ_API_KEY=
OPENAI_API_KEY=
# Force a provider: xai | groq | openai | ollama   (default: auto = first configured of xai, groq, openai)
LLM_PROVIDER=auto
# Default model (must exist for the chosen provider). xAI: grok-4.3 (reasoning_effort=none) is the
# low-latency choice. Groq: llama-3.3-70b-versatile.
# LLM_MODEL=grok-4.3
LLM_MAX_TOKENS=260
LLM_TEMPERATURE=0.7

# ---- Speech ----------------------------------------------------------------
STT_ENGINE=parakeet            # parakeet | whisper
STT_MODEL=mlx-community/parakeet-tdt-0.6b-v3
STT_FALLBACK_MODEL=mlx-community/whisper-small-mlx
TTS_ENGINE=kokoro              # kokoro | pocket | macos_say
TTS_VOICE=af_heart
TTS_SPEED=1.05

# ---- Turn detection ---------------------------------------------------------
VAD_THRESHOLD=0.6              # raise toward 0.8 in noisy rooms, lower toward 0.4 if it misses you
VAD_MIN_VOLUME=0.3           # lower if the coach doesn't hear a quiet mic
VAD_END_SILENCE_MS=650         # how long you must pause before the coach answers
VAD_MIN_SPEECH_MS=200
BARGE_IN_ENABLED=true
BARGE_IN_MIN_SPEECH_MS=350
BARGE_IN_THRESHOLD=0.7

# ---- Server ----------------------------------------------------------------
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=INFO
